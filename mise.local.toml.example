# 管理端末のローカル設定例。詳細: docs/operations/aws-runtime-auth.md
# mise.local.tomlがない場合だけコピーし、既存ファイルがあれば必要な項目を[env]へ追記する。
# mise.local.tomlはGit管理対象外。秘密鍵や証明書の本文はここに記入しない。

[env]
# 証明書更新時に必須: CAを保管する管理端末でhostnameを実行し、その出力を固定文字列で記入する。
# VPSのhostnameや、実行時にhostnameを自動取得する式は設定しない。
# 空欄のままでは、証明書更新taskは鍵生成・SSH接続より前に停止する。
OKAWAK_BLOG_CERTIFICATE_ISSUER_HOST = ""

# 以下は必要な場合だけコメントを外して設定する。

# 更新対象のSSH接続先。既定はoci。taskの引数で指定した接続先が優先される。
# OKAWAK_BLOG_VPS_SSH_TARGET = "oci"

# SSH configにPortがない場合などに指定する。未設定ならSSH configに従う。
# OKAWAK_BLOG_VPS_SSH_PORT = "60022"

# ca-key.pem、ca-cert.pem、ca-cert.srlの保管先を絶対パスで指定する。
# 既定は${XDG_DATA_HOME:-${HOME}/.local/share}/okawak-blog-pki。
# OKAWAK_BLOG_PKI_DIR = "/absolute/path/to/okawak-blog-pki"

# 証明書更新で検証するS3 bucket。dev / test-e2e-s3でも使用する。
# 証明書更新taskの既定値は以下。dev / test-e2e-s3では明示的な設定が必要。
# OKAWAK_BLOG_ARTIFACT_BUCKET = "okawak-blog-resources-bucket"

# 新しいclient certificateの有効日数。既定90日、最小8日。CAの残存期間内で指定する。
# OKAWAK_BLOG_CERTIFICATE_DAYS = "90"

# AWS側で許可したSubject CNと一致させる。既定値から変更している場合だけ設定する。
# OKAWAK_BLOG_CERTIFICATE_SUBJECT_CN = "okawak-blog-vps"
