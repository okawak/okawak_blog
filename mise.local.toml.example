# 管理端末専用のローカル設定例。VPSにはこのファイルやmise.local.tomlを配置しない。
# デプロイ: service/README.md、証明書更新: docs/operations/aws-runtime-auth.md
# mise.local.tomlがない場合だけコピーし、既存ファイルがあれば必要な項目を[env]へ追記する。
# mise.local.tomlはGit管理対象外。秘密鍵や証明書の本文はここに記入しない。

[env]
# *-vps / rotate-runtime-certificate共通のSSH接続先。SSH configのHost名などを指定する。
# 必須（taskの引数でも指定可能、引数が優先）。固定の接続先へのfallbackはない。
# 例: SSH configが「Host oci」なら "oci" を記入する。
OKAWAK_BLOG_VPS_SSH_TARGET = ""

# VPS上のrepository / インストール先。deploy-vpsの作業ディレクトリに使用する。
# 必須。未設定・空欄ならSSH接続前に停止する。既定のパスへのfallbackはない。
# 例: /opt/okawak_blog。英数字、/、.、_、- のみを含む絶対パスを指定する。
OKAWAK_BLOG_VPS_REPO_DIR = ""

# 証明書更新時に必須: CAを保管する管理端末でhostnameを実行し、その出力を固定文字列で記入する。
# VPSのhostnameや、実行時にhostnameを自動取得する式は設定しない。
# 空欄のままでは、証明書更新taskは鍵生成・SSH接続より前に停止する。
OKAWAK_BLOG_CERTIFICATE_ISSUER_HOST = ""
